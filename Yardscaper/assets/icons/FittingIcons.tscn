[sub_resource type="GDScript" id="GDScript_i8r4u"]
script/source = "extends Node

@export var CUSTOM                  : Texture2D = null
@export var CUSTOM_OUTLINED         : Texture2D = null
@export var COUPLING                : Texture2D = null
@export var COUPLING_OUTLINED       : Texture2D = null
@export var ELBOW_90                : Texture2D = null
@export var ELBOW_90_OUTLINED       : Texture2D = null
@export var ELBOW_45                : Texture2D = null
@export var ELBOW_45_OUTLINED       : Texture2D = null
@export var TEE_BRANCH_OUT          : Texture2D = null
@export var TEE_BRANCH_OUT_OUTLINED : Texture2D = null
@export var TEE_BRANCH_IN           : Texture2D = null
@export var TEE_BRANCH_IN_OUTLINED  : Texture2D = null
@export var TEE_RUN                 : Texture2D = null
@export var TEE_RUN_OUTLINED        : Texture2D = null

func from_type(fitting_type: PipeTables.FittingType, outlined: bool = false) -> Texture2D:
	if outlined:
		match fitting_type:
			PipeTables.FittingType.NONE:           return null
			PipeTables.FittingType.CUSTOM:         return CUSTOM_OUTLINED
			PipeTables.FittingType.COUPLING:       return COUPLING_OUTLINED
			PipeTables.FittingType.ELBOW_90:       return ELBOW_90_OUTLINED
			PipeTables.FittingType.ELBOW_45:       return ELBOW_45_OUTLINED
			PipeTables.FittingType.TEE_BRANCH_OUT: return TEE_BRANCH_OUT_OUTLINED
			PipeTables.FittingType.TEE_BRANCH_IN:  return TEE_BRANCH_IN_OUTLINED
			PipeTables.FittingType.TEE_RUN:        return TEE_RUN_OUTLINED
	else:
		match fitting_type:
			PipeTables.FittingType.NONE:           return null
			PipeTables.FittingType.CUSTOM:         return CUSTOM
			PipeTables.FittingType.COUPLING:       return COUPLING
			PipeTables.FittingType.ELBOW_90:       return ELBOW_90
			PipeTables.FittingType.ELBOW_45:       return ELBOW_45
			PipeTables.FittingType.TEE_BRANCH_OUT: return TEE_BRANCH_OUT
			PipeTables.FittingType.TEE_BRANCH_IN:  return TEE_BRANCH_IN
			PipeTables.FittingType.TEE_RUN:        return TEE_RUN
	push_warning(\"unsupported fitting type '%s' (outlined=%s)\" % [fitting_type, outlined])
	return null
"

